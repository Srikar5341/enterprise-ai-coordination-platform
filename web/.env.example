# Renova web frontend — environment configuration (no credentials, ever).
#
# Vite exposes ONLY variables prefixed with VITE_ to client-side code.
# NEVER put the OpenRouter API key, database passwords, JWT signing secrets
# or any other private credential here — those belong to the backend.

# ── API mode ────────────────────────────────────────────────────────────────
# "mock" (default) — every surface runs on the labeled demo adapter; nothing
#                    touches a backend.
# "http"           — the goal-to-task flow (submit goal → generate plan →
#                    review proposal → approve/reject) runs against the shared
#                    FastAPI backend; every not-yet-integrated surface stays
#                    mock-backed and labeled "Demo data".
VITE_OPSPILOT_API_MODE=mock

# ── FastAPI base URL ───────────────────────────────────────────────────────
# Local development default per the backend hand-off. Change for other
# environments. (VITE_OPSPILOT_API_BASE_URL is only read in http mode.)
VITE_OPSPILOT_API_BASE_URL=http://localhost:12345/api/v1

# ── Demo project id (integration blocker B1) ───────────────────────────────
# The verified backend contract starts at POST /projects/{project_id}/goals —
# there is no project-creation/list endpoint yet, so a project id must be
# provisioned externally (ask the backend owner) and set here for http mode.
VITE_OPSPILOT_DEMO_PROJECT_ID=

# ───────────────────────────────────────────────────────────────────────────
# How to run locally (frontend + FastAPI):
#   1. cp .env.example .env.local   (then edit the values above)
#   2. Start FastAPI on port 12345 (backend team's service)
#   3. bun install && bun run dev   (this app — http://localhost:3000)
#
# IMPORTANT: VITE_* variables are inlined at dev-server start time.
# After changing .env.local, RESTART the dev server for changes to apply.
#
# Authentication note: protected endpoints require a Bearer JWT. No login/
# token-provisioning endpoint exists in the verified backend contract yet
# (blocker B2) — see web/INTEGRATION_NOTES.md for the manual token mechanism.
# ───────────────────────────────────────────────────────────────────────────
