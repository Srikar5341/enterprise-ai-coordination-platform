# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=12345
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
PROJECT_NAME="Enterprise AI Team Coordination Platform"

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=platform_user
DB_PASSWORD=platform_pass
DB_NAME=ai_coordination
DATABASE_URL=mysql+pymysql://platform_user:platform_pass@localhost:3306/ai_coordination?charset=utf8mb4

# Authentication & JWT Security
JWT_SECRET_KEY=change_this_secret_in_production_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Settings (Configured via env, never committed or exposed to clients)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Proposal Configuration
PROPOSAL_TTL_HOURS=24

# Logging
LOG_LEVEL=INFO
