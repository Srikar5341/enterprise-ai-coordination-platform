    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service health, database, and Redis readiness check",
        "description": "Evaluate service liveness, database ping readiness, and Redis connectivity.\n\nReturns HTTP 200 when healthy (or degraded if Redis is down), or HTTP 503 when the database is unreachable.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Service is healthy or degraded (Redis unreachable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is degraded and database is disconnected"
          }
        }
      }
    },
