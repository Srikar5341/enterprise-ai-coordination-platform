  "components": {
    "schemas": {
      "GoalCreateRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "title": "Title",
            "description": "Goal title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Detailed goal context"
          },
          "target_date": {
            "type": "string",
            "format": "date-time",
            "title": "Target Date",
            "description": "Target completion datetime (must be UTC and in the future)"
          }
        },
        "type": "object",
        "required": [
          "title",
          "target_date"
        ],
        "title": "GoalCreateRequest"
      },
      "GoalResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "target_date": {
            "type": "string",
            "format": "date-time",
            "title": "Target Date"
          },
          "status": {
            "$ref": "#/components/schemas/GoalStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "project_id",
          "title",
          "target_date",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "GoalResponse"
      },
      "GoalStatus": {
        "type": "string",
        "enum": [
          "PENDING_PLANNING",
          "PLANNED",
          "IN_PROGRESS",
          "COMPLETED",
          "CANCELLED"
        ],
        "title": "GoalStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "redis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redis"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database",
          "environment"
        ],
        "title": "HealthResponse",
        "description": "Health check response payload schema."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "description": "User registered email address"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "title": "Password",
            "description": "Plaintext password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "User credentials for token issuance."
      },
      "LogoutRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "title": "Refresh Token",
            "description": "Opaque refresh token to revoke"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "LogoutRequest",
        "description": "Payload to revoke an active refresh token."
      },
      "PlanGenerateRequest": {
        "properties": {
          "goal_id": {
            "type": "string",
            "title": "Goal Id",
            "description": "UUID of the existing goal to plan"
          },
          "additional_instructions": {
            "anyOf": [
